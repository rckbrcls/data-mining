<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d4" for="edge" attr.name="weight" attr.type="long" />
  <key id="d3" for="edge" attr.name="relation" attr.type="string" />
  <key id="d2" for="node" attr.name="report_count" attr.type="long" />
  <key id="d1" for="node" attr.name="display_label" attr.type="string" />
  <key id="d0" for="node" attr.name="node_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="report:example">
      <data key="d0">report</data>
      <data key="d1">Example report</data>
      <data key="d2">1</data>
    </node>
    <node id="category:INTEGRIDADE &gt; FÍSICA">
      <data key="d0">category</data>
      <data key="d1">INTEGRIDADE &gt; FÍSICA</data>
      <data key="d2">1</data>
    </node>
    <node id="age_group:02 ANOS">
      <data key="d0">age_group</data>
      <data key="d1">02 ANOS</data>
      <data key="d2">1</data>
    </node>
    <node id="relationship:MÃE">
      <data key="d0">relationship</data>
      <data key="d1">MÃE</data>
      <data key="d2">1</data>
    </node>
    <node id="setting:CASA ONDE RESIDE A VÍTIMA E O SUSPEITO">
      <data key="d0">setting</data>
      <data key="d1">CASA ONDE RESIDE A VÍTIMA E O SUSPEITO</data>
      <data key="d2">1</data>
    </node>
    <node id="month:2026-01-01">
      <data key="d0">month</data>
      <data key="d1">2026-01-01</data>
      <data key="d2">1</data>
    </node>
    <edge source="report:example" target="category:INTEGRIDADE &gt; FÍSICA">
      <data key="d3">has violation</data>
      <data key="d4">1</data>
    </edge>
    <edge source="report:example" target="age_group:02 ANOS">
      <data key="d3">has victim age</data>
      <data key="d4">1</data>
    </edge>
    <edge source="report:example" target="relationship:MÃE">
      <data key="d3">has relationship</data>
      <data key="d4">1</data>
    </edge>
    <edge source="report:example" target="setting:CASA ONDE RESIDE A VÍTIMA E O SUSPEITO">
      <data key="d3">occurred in</data>
      <data key="d4">1</data>
    </edge>
    <edge source="report:example" target="month:2026-01-01">
      <data key="d3">registered during</data>
      <data key="d4">1</data>
    </edge>
  </graph>
</graphml>
